{
  "manifest_version": 3,
  "name": "Oxigênio · Wellhub & TotalPass Auto Check-in",
  "version": "1.1.0",
  "description": "Vigia os painéis do Wellhub/Gympass e TotalPass abertos, confirma check-ins pendentes e libera automaticamente no sistema Oxigênio.",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://partners.gympass.com/*",
    "https://partners.wellhub.com/*",
    "https://booking.totalpass.com/*",
    "https://sistema.academiaoxigenio.com/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://partners.gympass.com/new/validation/*",
        "https://partners.wellhub.com/new/validation/*",
        "https://partners.gympass.com/validation/*",
        "https://partners.wellhub.com/validation/*",
        "https://booking.totalpass.com/br/check-ins*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://sistema.academiaoxigenio.com/*",
        "http://localhost/*"
      ],
      "js": ["system-alert.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Oxigênio · Wellhub & TotalPass Auto Check-in"
  }
}
