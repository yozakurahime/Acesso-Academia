PORT=3000
DATA_DIR=./data

# Configuracao padrao do equipamento Control iD (pode ser alterada tambem pela tela do sistema)
CONTROLID_IP=192.168.0.100
CONTROLID_PORT=80
CONTROLID_USER=admin
CONTROLID_PASSWORD=admin
CONTROLID_ACTION_MODE=sec_box
CONTROLID_SECBOX_ID=65793
CONTROLID_GROUP_ID=1
CONTROLID_MOCK_MODE=false

# Dias de tolerancia apos o vencimento antes de bloquear na catraca
TOLERANCE_DAYS=3

# Chave opcional para validar webhooks de gateway de pagamento (Asaas, Mercado Pago, etc.)
WEBHOOK_SECRET=
MP_WEBHOOK_SECRET=
MP_ACCESS_TOKEN=
MP_POINT_ACCESS_TOKEN=
MP_POINT_TERMINAL_ID=
# Use se a aplicação da Point tiver um segredo de webhook próprio.
MP_POINT_WEBHOOK_SECRET=
MP_POINT_TEST_MODE=false
MP_POINT_TEST_ACCESS_TOKEN=
